# Copy this file to ".env" (same folder as package.json) and fill in YOUR values
# from Firebase Console > Project settings > Your apps > Web app > firebaseConfig.
# Never commit ".env" to Git (Vite projects ignore it via .gitignore - double check!).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
